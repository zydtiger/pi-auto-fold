{
  "name": "@zydtiger/pi-auto-fold",
  "version": "0.1.0",
  "description": "Show Pi activity while working, then fold thinking and tools after the answer.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "repository": { "type": "git", "url": "https://github.com/zydtiger/pi-auto-fold.git" },
  "keywords": ["pi-package", "pi-extension"],
  "files": ["src", "README.md", "LICENSE"],
  "pi": { "extensions": ["./src/extension.ts"] },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^26.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  }
}
